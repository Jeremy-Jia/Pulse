<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="8dp" android:background="@drawable/widget_frame">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_name"
        android:textColor="#78E8C6" android:textSize="13sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/widget_description" android:textColor="#A7B7C9" android:textSize="11sp" />
</LinearLayout>
